#!/usr/bin/env bash
set -e
IFS=$'\n\t'

FFMPEG="/usr/bin/ffmpeg"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KDIALOG="/usr/bin/kdialog"
PROGRESS="$SCRIPT_DIR/kdialog_progress"
NOTIFY="/usr/bin/notify-send"

# Embedded functions to avoid dependency issues
detect_video_codec() {
    local input_file="$1"
    local video_codec
    video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$input_file" 2>/dev/null || echo "unknown")
    echo "$video_codec"
}

detect_audio_streams() {
    local input_file="$1"
    local audio_streams
    audio_streams=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of csv=p=0 "$input_file" 2>/dev/null)
    if [[ -z "$audio_streams" ]]; then
        echo "none"
    else
        echo "$audio_streams"
    fi
}

has_aac_audio() {
    local input_file="$1"
    local audio_streams
    audio_streams=$(detect_audio_streams "$input_file")
    if [[ "$audio_streams" == "none" ]]; then
        return 1
    fi
    if echo "$audio_streams" | grep -q "aac"; then
        return 0
    else
        return 1
    fi
}

# --- NEW LOGIC: Scanning and questioning ---
FILES_TO_PROCESS=()
FILES_ALREADY_AAC=()

for FILE in "$@"; do
    [[ -f "$FILE" ]] || continue
    if has_aac_audio "$FILE"; then
        FILES_ALREADY_AAC+=("$FILE")
    else
        # Only add if it actually has audio (to avoid errors later)
        if [[ $(detect_audio_streams "$FILE") != "none" ]]; then
            FILES_TO_PROCESS+=("$FILE")
        fi
    fi
done

# If there are files already containing AAC, ask the user
if [[ ${#FILES_ALREADY_AAC[@]} -gt 0 ]]; then
    # Build a list for the dialog
    list_text=""
    for f in "${FILES_ALREADY_AAC[@]}"; do
        list_text+="$(basename "$f")"$'\n'
    done

    if $KDIALOG --title "AAC already present" --yesno \
        "The following files already contain AAC audio:

$list_text
Do you want to re-encode them anyway (to fix potential profile/muxer issues)?"; then
        # Add them to the process list
        FILES_TO_PROCESS+=("${FILES_ALREADY_AAC[@]}")
    fi
fi

# If no files to process, exit
if [[ ${#FILES_TO_PROCESS[@]} -eq 0 ]]; then
    $NOTIFY "To AAC" "No files to process"
    exit 0
fi
# --------------------------------------------

# Convert audio streams to AAC (192kb/s, 48kHz) while preserving video/subtitles/metadata
for INPUT in "${FILES_TO_PROCESS[@]}"; do
  DIR="$(dirname "$INPUT")"
  BASENAME="$(basename "$INPUT")"
  EXT="${BASENAME##*.}"
  NAME="${BASENAME%.*}"

  # Smart container selection based on video codec
  video_codec=$(detect_video_codec "$INPUT")
  if [[ "$video_codec" == "dnxhd" ]]; then
    # DNxHD/DNxHR requires .mov container
    TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mov")"
    container_ext="mov"
  else
    # Other codecs work in .mp4 container
    TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mp4")"
    container_ext="mp4"
  fi

  # get duration (HH:MM:SS.ms)
  DURATION=$($FFMPEG -i "$INPUT" 2>&1 | grep "Duration" | awk '{print $2}' | tr -d , || echo "00:00:00.00")
  HOURS=${DURATION:0:2}
  MINUTES=${DURATION:3:2}
  SECONDS=${DURATION:6:5}
  TOTAL_SEC=$(echo "$HOURS*3600 + $MINUTES*60 + $SECONDS" | bc)

  (
    $FFMPEG -y -i "$INPUT" \
      -map 0 -map -0:d \
      -c:v copy \
      -c:a aac -b:a 192k -ar 48000 \
      -c:s copy \
      -map_metadata 0 \
      "$TMP_OUTPUT" -progress pipe:1 2>/dev/null | \
    while read -r line; do
      if [[ "$line" =~ out_time_ms=([0-9]+) ]]; then
        OUT_MS=${BASH_REMATCH[1]}
        OUT_SEC=$(echo "$OUT_MS / 1000000" | bc)
        # Avoid divide by zero
        if [[ "$TOTAL_SEC" -gt 0 ]]; then
          PCT=$(echo "$OUT_SEC * 100 / $TOTAL_SEC" | bc)
          if [[ "$PCT" -lt 0 ]]; then PCT=0; fi
          if [[ "$PCT" -gt 100 ]]; then PCT=100; fi
        else
          PCT=0
        fi
        echo $PCT
        echo "# Converting $BASENAME to AAC — $(date -u -d @$OUT_SEC +%T) elapsed"
      fi
    done
  ) | $PROGRESS "To AAC (replace)"

  if [[ -f "$TMP_OUTPUT" ]]; then
    mv "$INPUT" "${INPUT}.bak"
    mv "$TMP_OUTPUT" "$INPUT"
    rm -f "${INPUT}.bak"
    $NOTIFY "To AAC" "Replaced: $BASENAME with AAC audio ($container_ext)"
  else
    $NOTIFY "To AAC" "Conversion failed: $BASENAME"
  fi
done
