#!/usr/bin/env bash
set -e
IFS=$'\n\t'

FFMPEG="/usr/bin/ffmpeg"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KDIALOG="/usr/bin/kdialog"
NOTIFY="/usr/bin/notify-send"
# shellcheck source=lib_batch_progress.sh
source "$SCRIPT_DIR/lib_batch_progress.sh"

detect_video_codec() {
    local input_file="$1"
    local video_codec
    video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$input_file" 2>/dev/null || echo "unknown")
    echo "$video_codec"
}

detect_audio_streams() {
    local input_file="$1"
    local audio_streams
    audio_streams=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of csv=p=0 "$input_file" 2>/dev/null)
    if [[ -z "$audio_streams" ]]; then
        echo "none"
    else
        echo "$audio_streams"
    fi
}

has_aac_audio() {
    local input_file="$1"
    local audio_streams
    audio_streams=$(detect_audio_streams "$input_file")
    if [[ "$audio_streams" == "none" ]]; then
        return 1
    fi
    if echo "$audio_streams" | grep -q "aac"; then
        return 0
    else
        return 1
    fi
}

FILES_TO_PROCESS=()
FILES_ALREADY_AAC=()

for FILE in "$@"; do
    [[ -f "$FILE" ]] || continue
    if has_aac_audio "$FILE"; then
        FILES_ALREADY_AAC+=("$FILE")
    else
        if [[ $(detect_audio_streams "$FILE") != "none" ]]; then
            FILES_TO_PROCESS+=("$FILE")
        fi
    fi
done

if [[ ${#FILES_ALREADY_AAC[@]} -gt 0 ]]; then
    list_text=""
    for f in "${FILES_ALREADY_AAC[@]}"; do
        list_text+="$(basename "$f")"$'\n'
    done

    if $KDIALOG --title "AAC already present" --yesno \
        "The following files already contain AAC audio:

$list_text
Do you want to re-encode them anyway (to fix potential profile/muxer issues)?"; then
        FILES_TO_PROCESS+=("${FILES_ALREADY_AAC[@]}")
    fi
fi

if [[ ${#FILES_TO_PROCESS[@]} -eq 0 ]]; then
    $NOTIFY "To AAC" "No files to process"
    exit 0
fi

batch_progress_start "To AAC (replace)" "AAC" "${FILES_TO_PROCESS[@]}"
trap 'batch_progress_close' EXIT

for INPUT in "${FILES_TO_PROCESS[@]}"; do
  DIR="$(dirname "$INPUT")"
  BASENAME="$(basename "$INPUT")"
  NAME="${BASENAME%.*}"

  video_codec=$(detect_video_codec "$INPUT")
  if [[ "$video_codec" == "dnxhd" ]]; then
    TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mov")"
    container_ext="mov"
  else
    TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mp4")"
    container_ext="mp4"
  fi

  if ! ffmpeg_with_batch_progress $FFMPEG -y -i "$INPUT" \
      -map 0 -map -0:d \
      -c:v copy \
      -c:a aac -b:a 192k -ar 48000 \
      -c:s copy \
      -map_metadata 0 \
      "$TMP_OUTPUT"; then
    $NOTIFY "To AAC" "Conversion failed: $BASENAME"
    rm -f "$TMP_OUTPUT"
    batch_progress_advance
    continue
  fi

  if [[ -f "$TMP_OUTPUT" ]]; then
    mv "$INPUT" "${INPUT}.bak"
    mv "$TMP_OUTPUT" "$INPUT"
    rm -f "${INPUT}.bak"
    $NOTIFY "To AAC" "Replaced: $BASENAME with AAC audio ($container_ext)"
  else
    $NOTIFY "To AAC" "Conversion failed: $BASENAME"
  fi

  batch_progress_advance
done

batch_progress_close
trap - EXIT
