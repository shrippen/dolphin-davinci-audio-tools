#!/usr/bin/env bash
set -e
IFS=$'\n\t'

FFMPEG="/usr/bin/ffmpeg"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KDIALOG="/usr/bin/kdialog"
NOTIFY="/usr/bin/notify-send"
# shellcheck source=lib_batch_progress.sh
source "$SCRIPT_DIR/lib_batch_progress.sh"

is_valid_file() {
    local input_file="$1"
    local min_size=1024

    if [[ ! -f "$input_file" || ! -r "$input_file" ]]; then
        return 1
    fi

    local file_size
    file_size=$(stat -c%s "$input_file" 2>/dev/null || echo 0)
    if [[ $file_size -lt $min_size ]]; then
        return 1
    fi

    if ! ffprobe -v error -show_format "$input_file" >/dev/null 2>&1; then
        return 1
    fi

    return 0
}

detect_video_resolution() {
    local input_file="$1"
    local width height resolution
    width=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$input_file" 2>/dev/null || echo "0")
    height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$input_file" 2>/dev/null || echo "0")
    if [[ "$width" -eq 0 || "$height" -eq 0 ]]; then
        resolution=$($FFMPEG -i "$input_file" 2>&1 | grep -oE "[0-9]{3,5}x[0-9]{3,5}" | head -1)
        if [[ -n "$resolution" ]]; then
            width=$(echo "$resolution" | cut -d"x" -f1)
            height=$(echo "$resolution" | cut -d"x" -f2)
        fi
    fi
    echo "$width,$height"
}

has_video_streams() {
    local input_file="$1"
    local video_streams
    video_streams=$(ffprobe -v error -select_streams v -show_entries stream=codec_type -of csv=p=0 "$input_file" 2>/dev/null)
    if [[ -n "$video_streams" ]]; then
        return 0
    else
        return 1
    fi
}

QUEUE=()
declare -A QUEUE_META_WIDTH QUEUE_META_HEIGHT QUEUE_META_CODEC_NAME
declare -A QUEUE_META_BITRATE QUEUE_META_PROFILE QUEUE_META_MODE

THRESHOLD=$((1920 * 1080))

for INPUT in "$@"; do
  [[ -f "$INPUT" ]] || continue
  BASENAME="$(basename "$INPUT")"

  if ! is_valid_file "$INPUT"; then
    $NOTIFY "Davinci Resolve" "Skipped: $BASENAME (file is corrupted or unreadable)"
    continue
  fi

  if ! has_video_streams "$INPUT"; then
    $NOTIFY "Davinci Resolve" "Skipped: $BASENAME (no video streams — DNx conversion requires video)"
    continue
  fi

  resolution=$(detect_video_resolution "$INPUT")
  WIDTH=$(echo "$resolution" | cut -d',' -f1)
  HEIGHT=$(echo "$resolution" | cut -d',' -f2)

  if [[ "$WIDTH" -le 0 || "$HEIGHT" -le 0 ]]; then
    $NOTIFY "Davinci Resolve" "Resolution detection failed for $BASENAME (file may be corrupted or unsupported)"
    continue
  fi

  TOTAL_PIXELS=$((WIDTH * HEIGHT))
  if [[ $TOTAL_PIXELS -le $THRESHOLD ]]; then
    CODEC_NAME="DNxHD (1080p)"
    MODE="dnxhd"
    BITRATE="185M"
    PROFILE=""
  else
    CODEC_NAME="DNxHR SQ (4K+)"
    MODE="dnxhr"
    BITRATE=""
    PROFILE="dnxhr_sq"
  fi

  QUEUE+=("$INPUT")
  QUEUE_META_WIDTH["$INPUT"]="$WIDTH"
  QUEUE_META_HEIGHT["$INPUT"]="$HEIGHT"
  QUEUE_META_CODEC_NAME["$INPUT"]="$CODEC_NAME"
  QUEUE_META_BITRATE["$INPUT"]="$BITRATE"
  QUEUE_META_PROFILE["$INPUT"]="$PROFILE"
  QUEUE_META_MODE["$INPUT"]="$MODE"
done

if [[ ${#QUEUE[@]} -eq 0 ]]; then
  exit 0
fi

batch_progress_start "Davinci Resolve conversion" "DNx" "${QUEUE[@]}"
trap 'batch_progress_close' EXIT

for INPUT in "${QUEUE[@]}"; do
  DIR="$(dirname "$INPUT")"
  BASENAME="$(basename "$INPUT")"
  EXT="${BASENAME##*.}"
  NAME="${BASENAME%.*}"
  WIDTH="${QUEUE_META_WIDTH[$INPUT]}"
  HEIGHT="${QUEUE_META_HEIGHT[$INPUT]}"
  CODEC_NAME="${QUEUE_META_CODEC_NAME[$INPUT]}"
  MODE="${QUEUE_META_MODE[$INPUT]}"
  BITRATE="${QUEUE_META_BITRATE[$INPUT]}"
  PROFILE="${QUEUE_META_PROFILE[$INPUT]}"
  FRAME_RATE="30"
  CODEC="dnxhd"

  BP_ACTION="$CODEC_NAME"
  batch_progress_tick 0 1

  TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mov")"

  if [[ "$MODE" == "dnxhd" ]]; then
    ffmpeg_ok=true
    ffmpeg_with_batch_progress $FFMPEG -y -i "$INPUT" \
      -map 0 \
      -c:v "$CODEC" -b:v "$BITRATE" -r "$FRAME_RATE" -pix_fmt yuv422p \
      -c:a pcm_s24le -ar 48000 \
      -c:s copy \
      -map_metadata 0 \
      "$TMP_OUTPUT" || ffmpeg_ok=false
  else
    ffmpeg_ok=true
    ffmpeg_with_batch_progress $FFMPEG -y -i "$INPUT" \
      -map 0 \
      -c:v "$CODEC" -profile:v "$PROFILE" -r "$FRAME_RATE" -pix_fmt yuv422p \
      -c:a pcm_s24le -ar 48000 \
      -c:s copy \
      -map_metadata 0 \
      "$TMP_OUTPUT" || ffmpeg_ok=false
  fi

  if [[ "$ffmpeg_ok" != true ]]; then
    $NOTIFY "Davinci Resolve" "Conversion failed: $BASENAME (FFmpeg error)"
    rm -f "$TMP_OUTPUT"
    batch_progress_advance
    continue
  fi

  if [[ -f "$TMP_OUTPUT" ]]; then
    if [[ "$EXT" != "mov" ]]; then
      NEW_BASENAME="${NAME}.mov"
      mv "$INPUT" "${INPUT}.bak"
      mv "$TMP_OUTPUT" "$DIR/$NEW_BASENAME"
      rm -f "${INPUT}.bak"
      $NOTIFY "Davinci Resolve" "Replaced: $BASENAME → $NEW_BASENAME ($CODEC_NAME, ${WIDTH}x${HEIGHT})"
    else
      mv "$INPUT" "${INPUT}.bak"
      mv "$TMP_OUTPUT" "$INPUT"
      rm -f "${INPUT}.bak"
      $NOTIFY "Davinci Resolve" "Replaced: $BASENAME → $CODEC_NAME (${WIDTH}x${HEIGHT})"
    fi
  else
    $NOTIFY "Davinci Resolve" "Conversion failed: $BASENAME"
  fi

  batch_progress_advance
done

batch_progress_close
trap - EXIT
