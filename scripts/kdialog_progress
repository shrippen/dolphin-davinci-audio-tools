#!/usr/bin/env bash
# Native KDE progress dialog that accepts zenity-style stdin:
#   - lines that are integers set the percentage (0–100)
#   - lines starting with "# " update the label text
set -euo pipefail

TITLE="${1:-Progress}"
LABEL="${2:-Working…}"

KDIALOG="${KDIALOG:-/usr/bin/kdialog}"

if command -v qdbus6 >/dev/null 2>&1; then
  QDBUS="qdbus6"
elif command -v qdbus >/dev/null 2>&1; then
  QDBUS="qdbus"
else
  echo "Neither qdbus6 nor qdbus found (needed for kdialog progress)." >&2
  cat >/dev/null
  exit 1
fi

if [[ ! -x "$KDIALOG" ]]; then
  if command -v kdialog >/dev/null 2>&1; then
    KDIALOG="$(command -v kdialog)"
  else
    echo "kdialog not found." >&2
    cat >/dev/null
    exit 1
  fi
fi

DBUS_REF=$("$KDIALOG" --title "$TITLE" --progressbar "$LABEL" 100)
qdbus_call() {
  "$QDBUS" $DBUS_REF "$@" >/dev/null 2>&1 || true
}

qdbus_call Set "" value 0
qdbus_call setAutoClose true

cleanup() {
  qdbus_call close
}
trap cleanup EXIT

while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ "$line" == \#* ]]; then
    label="${line#\#}"
    label="${label#"${label%%[![:space:]]*}"}"
    qdbus_call setLabelText "$label"
  elif [[ "$line" =~ ^[0-9]+$ ]]; then
    pct=$line
    if (( pct < 0 )); then pct=0; fi
    if (( pct > 100 )); then pct=100; fi
    qdbus_call Set "" value "$pct"
  fi
done

trap - EXIT
qdbus_call close
