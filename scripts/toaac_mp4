#!/usr/bin/env bash
set -e
IFS=$'\n\t'

FFMPEG="/usr/bin/ffmpeg"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KDIALOG="/usr/bin/kdialog"
NOTIFY="/usr/bin/notify-send"
# shellcheck source=lib_batch_progress.sh
source "$SCRIPT_DIR/lib_batch_progress.sh"

detect_video_codec() {
    local input_file="$1"
    local video_codec
    video_codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$input_file" 2>/dev/null || echo "unknown")
    echo "$video_codec"
}

detect_audio_streams() {
    local input_file="$1"
    local audio_streams
    audio_streams=$(ffprobe -v error -select_streams a -show_entries stream=codec_name -of csv=p=0 "$input_file" 2>/dev/null)
    if [[ -z "$audio_streams" ]]; then
        echo "none"
    else
        echo "$audio_streams"
    fi
}

has_aac_audio() {
    local input_file="$1"
    local audio_streams
    audio_streams=$(detect_audio_streams "$input_file")
    if [[ "$audio_streams" == "none" ]]; then
        return 1
    fi
    if echo "$audio_streams" | grep -q "aac"; then
        return 0
    else
        return 1
    fi
}

get_unique_filename() {
    local dir="$1"
    local name="$2"
    local ext="$3"
    local counter=1
    if [[ ! -f "$dir/$name.$ext" ]]; then
        echo "$name.$ext"
        return 0
    fi
    while [[ -f "$dir/$name ($counter).$ext" ]]; do
        ((counter++))
    done
    echo "$name ($counter).$ext"
}

QUEUE=()
for INPUT in "$@"; do
  [[ -f "$INPUT" ]] || continue
  BASENAME="$(basename "$INPUT")"

  if has_aac_audio "$INPUT"; then
    $NOTIFY "To AAC" "Skipped: $BASENAME (already has AAC audio)"
    continue
  fi

  audio_streams=$(detect_audio_streams "$INPUT")
  if [[ "$audio_streams" == "none" ]]; then
    $NOTIFY "To AAC" "Skipped: $BASENAME (no audio streams found)"
    continue
  fi

  QUEUE+=("$INPUT")
done

if [[ ${#QUEUE[@]} -eq 0 ]]; then
  exit 0
fi

batch_progress_start "To AAC (smart container)" "AAC" "${QUEUE[@]}"
trap 'batch_progress_close' EXIT

for INPUT in "${QUEUE[@]}"; do
  DIR="$(dirname "$INPUT")"
  BASENAME="$(basename "$INPUT")"
  NAME="${BASENAME%.*}"

  video_codec=$(detect_video_codec "$INPUT")
  if [[ "$video_codec" == "dnxhd" ]]; then
    output_filename=$(get_unique_filename "$DIR" "$NAME" "mov")
    TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mov")"
    container_ext="mov"
  else
    output_filename=$(get_unique_filename "$DIR" "$NAME" "mp4")
    TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.mp4")"
    container_ext="mp4"
  fi

  if ! ffmpeg_with_batch_progress $FFMPEG -y -i "$INPUT" \
      -map 0 -map -0:d \
      -c:v copy \
      -c:a aac -b:a 192k -ar 48000 \
      -c:s copy \
      -map_metadata 0 \
      "$TMP_OUTPUT"; then
    $NOTIFY "To AAC" "Conversion failed: $BASENAME"
    rm -f "$TMP_OUTPUT"
    batch_progress_advance
    continue
  fi

  if [[ -f "$TMP_OUTPUT" ]]; then
    FINAL="$DIR/$output_filename"
    mv "$TMP_OUTPUT" "$FINAL"
    if [[ "$output_filename" != "${NAME}.${container_ext}" ]]; then
      $NOTIFY "To AAC" "Created: $output_filename (renamed to avoid overwrite, $container_ext container)"
    else
      $NOTIFY "To AAC" "Created: $output_filename ($container_ext container)"
    fi
  else
    $NOTIFY "To AAC" "Conversion failed: $BASENAME"
  fi

  batch_progress_advance
done

batch_progress_close
trap - EXIT
