#!/usr/bin/env bash
set -e
IFS=$'\n\t'

FFMPEG="/usr/bin/ffmpeg"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOTIFY="/usr/bin/notify-send"
# shellcheck source=lib_media_helpers.sh
source "$SCRIPT_DIR/lib_media_helpers.sh"
# shellcheck source=lib_batch_progress.sh
source "$SCRIPT_DIR/lib_batch_progress.sh"

QUEUE=()
for INPUT in "$@"; do
  [[ -f "$INPUT" ]] || continue
  BASENAME="$(basename "$INPUT")"

  if ! is_valid_file "$INPUT"; then
    $NOTIFY "Audio→WAV" "Skipped: $BASENAME (file is corrupted or unreadable)"
    continue
  fi

  if ! is_audio_only "$INPUT"; then
    if has_video_streams "$INPUT"; then
      $NOTIFY "Audio→WAV" "Skipped: $BASENAME (video file — use “Audio to WAV (keep container)” instead)"
    else
      $NOTIFY "Audio→WAV" "Skipped: $BASENAME (no audio streams found)"
    fi
    continue
  fi

  QUEUE+=("$INPUT")
done

if [[ ${#QUEUE[@]} -eq 0 ]]; then
  exit 0
fi

batch_progress_start "Audio → WAV (.wav)" "WAV" "${QUEUE[@]}"
trap 'batch_progress_close' EXIT

for INPUT in "${QUEUE[@]}"; do
  DIR="$(dirname "$INPUT")"
  BASENAME="$(basename "$INPUT")"
  NAME="${BASENAME%.*}"
  EXT="${BASENAME##*.}"
  NEW_BASENAME="${NAME}.wav"
  TMP_OUTPUT="$(mktemp --tmpdir="$DIR" ".${NAME}.XXXXXX.wav")"

  if ! ffmpeg_with_batch_progress $FFMPEG -y -i "$INPUT" \
      -map 0:a:0 \
      -c:a pcm_s16le -ar 48000 \
      -map_metadata 0 \
      "$TMP_OUTPUT"; then
    $NOTIFY "Audio→WAV" "Conversion failed: $BASENAME (FFmpeg error, original was NOT touched)"
    rm -f "$TMP_OUTPUT"
    batch_progress_advance
    continue
  fi

  if ! is_valid_file "$TMP_OUTPUT"; then
    $NOTIFY "Audio→WAV" "Conversion failed: $BASENAME (output invalid, original was NOT touched)"
    rm -f "$TMP_OUTPUT"
    batch_progress_advance
    continue
  fi

  if [[ "$EXT" == "wav" ]]; then
    mv "$INPUT" "${INPUT}.bak"
    mv "$TMP_OUTPUT" "$INPUT"
    rm -f "${INPUT}.bak"
    $NOTIFY "Audio→WAV" "Replaced: $BASENAME"
  else
    replace_original_with "$INPUT" "$TMP_OUTPUT" "$NEW_BASENAME"
    $NOTIFY "Audio→WAV" "Replaced: $BASENAME → $NEW_BASENAME"
  fi

  batch_progress_advance
done

batch_progress_close
trap - EXIT
